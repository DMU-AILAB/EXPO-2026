# 서버
HOST=0.0.0.0
PORT=8000
DEBUG=false

# JWT — 운영에서는 반드시 바꿀 것
JWT_SECRET_KEY=changeme_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 데이터베이스
DATABASE_URL=sqlite:///./data/visionguide.db

# 업로드된 안내 음성이 쌓이는 곳
AUDIO_DIR=./data/audio

# CORS — Vite 개발 서버와 배포 도메인
# PC의 실제 LAN 주소로 바꾼다.
CORS_ORIGINS=http://192.168.0.50:5173

# ★ 기기가 이벤트·하트비트를 보낼 **이 서버의 주소**.
#
# `auto`(권장): 기기에 닿는 경로의 서버 IP를 그때그때 계산한다 — 노트북이 Wi-Fi를
# 옮겨도 이 파일을 고치지 않는다. 하트비트가 끊긴 기기는 서버가 알아서 새 주소로
# 맞춘다(services/address_sync.py). 포트는 서버가 실제로 받은 요청의 포트를 쓰고,
# 기동 직후에는 위의 PORT를 쓰므로 `uvicorn --port`와 PORT를 같게 두는 것이 좋다.
#
# 고정 주소를 쓰려면 URL을 직접 적는다(예: http://192.168.0.50:8000). 이 경우
# 서버 IP가 바뀌면 직접 고쳐야 한다. 기기에서 닿지 않는 주소면 이벤트는 outbox에
# 쌓이기만 하고 대시보드는 조용하다 — 기기 상세의 "연결 진단"이 이를 알려 준다.
PUBLIC_BASE_URL=auto

# 관리자 초기 계정 (python -m app.db.init_db 가 1회 사용)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
