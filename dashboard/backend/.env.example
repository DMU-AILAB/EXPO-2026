# 서버
HOST=0.0.0.0
PORT=8000
DEBUG=false

# JWT — 운영에서는 반드시 바꿀 것
JWT_SECRET_KEY=changeme_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 데이터베이스
DATABASE_URL=sqlite:///./data/visionguide.db

# 업로드된 안내 음성이 쌓이는 곳
AUDIO_DIR=./data/audio

# CORS — Vite 개발 서버와 배포 도메인
CORS_ORIGINS=http://localhost:5173

# ★ 기기가 이벤트·하트비트를 보낼 **이 서버의 주소**.
#
# 디바이스를 등록할 때 Pi에 그대로 심어진다. 비어 있거나 기기에서 닿지 않는 주소면
# Pi의 DeviceIdentity.is_usable()이 False가 되어 **아무것도 전송되지 않는다** —
# 이벤트는 outbox에 쌓이기만 하고 대시보드는 영원히 조용하다.
# localhost가 아니라 기기가 볼 수 있는 IP/도메인이어야 한다.
PUBLIC_BASE_URL=http://192.168.1.10:8000

# 관리자 초기 계정 (python -m app.db.init_db 가 1회 사용)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
