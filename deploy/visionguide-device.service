[Unit]
Description=VisionGuide White Cane Detection (headless, MJPEG :8080)
After=network.target sound.target
Wants=sound.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=/home/__USER__/visionguide
ExecStart=__PI_PYTHON__ /home/__USER__/visionguide/camera_live_pi.py --headless --port 8080 --roi-config /home/__USER__/visionguide/rois.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
