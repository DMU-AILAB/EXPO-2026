[Unit]
Description=VisionGuide White Cane Detection (headless, MJPEG :8080)
After=network.target sound.target
Wants=sound.target

[Service]
Type=simple
User=__USER__
Environment=PYTHONUNBUFFERED=1
# Pi 4 native USB 2.0/3.0 ports share a power group.  Current deployment does not use TPU.
Environment=VISIONGUIDE_USB_AUDIO_HUB=1-1
Environment=VISIONGUIDE_USB_AUDIO_SETTLE=0.3
WorkingDirectory=/home/__USER__/visionguide
ExecStart=__PI_PYTHON__ /home/__USER__/visionguide/camera_live_pi.py --headless --port 8080 --roi-config /home/__USER__/visionguide/rois.json --status-led 27 --model-variant v4_320 --inference-backend tflite
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
